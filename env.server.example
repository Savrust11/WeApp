SESSION_SECRET=replace-with-long-random-secret

# Public origin used to build OAuth redirect URIs (no trailing slash).
# Required in production so the LINE callback URL matches the value
# registered in the LINE Developers Console exactly.
# Example: https://we-iku.app
PUBLIC_BASE_URL=

# LINE Login
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Apple Sign In verification target
# Use iOS bundle id for native sign-in flow.
APPLE_BUNDLE_ID=com.weyuapp.app
