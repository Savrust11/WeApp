# EAS build ignore file - reduces upload size

# Android (not needed for iOS builds)
android/build/
android/.gradle/
android/app/build/
android/app/.cxx/

# iOS build artifacts
ios/build/
ios/Pods/
ios/DerivedData/
ios/*.xcarchive

# Node modules (EAS installs them on the server)
# Uncomment below only if you don't use native modules that need local node_modules
node_modules/

# Local build output and other heavy files
dev.apk
update.zip

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Development files
.expo/
dist/
web-build/
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Misc
.DS_Store
.env.local
.env.development
*.docx
PROGRESS_REPORT*
*.md
