# Point this to your backend server
# In dev: use your local machine's LAN IP (not localhost - emulators can't reach it)
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
EXPO_PUBLIC_API_URL=https://we-iku.app

# Google OAuth Client IDs
# Get from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client IDs for iOS, Android, and Web
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
GOOGLE_WEB_CLIENT_SECRET=your-google-client-secret
ANDROID_HOME=C:\Users\Administrator\AppData\Local\Android\Sdk

LINE_CALLBACK_URL=https://we-iku.app/api/auth/line/callback

LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret