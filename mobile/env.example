EXPO_PUBLIC_API_URL=https://your-api-domain.com

# Local native builds (`npx expo run:android`). After installing Android Studio + SDK, set this
# to your SDK path (default on Windows: C:\Users\<you>\AppData\Local\Android\Sdk).
# ANDROID_HOME=C:\Users\YourName\AppData\Local\Android\Sdk

# Google OAuth client IDs (Google Cloud Console)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
