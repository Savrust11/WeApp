{
  "expo": {
    "name": "We育",
    "slug": "weyu",
    "scheme": "weyu",
    "version": "1.0.0",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a76dac5d-671d-4b95-be22-d5e4da3bea53",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C5CBF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.weyuapp3.app",
      "buildNumber": "1",
